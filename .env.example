# ============================================================
# Jatayu — Environment Configuration
# ============================================================

# --- Database ---
# SQLite for development (default). Use full PostgreSQL URL for production.
DATABASE_URL=

# --- Server ---
API_HOST=0.0.0.0
API_PORT=8000

# --- ML & Simulation ---
MODEL_DIR=models
RANDOM_SEED=42
PREDICTION_HORIZON_HOURS=20

# --- Risk Thresholds ---
RISK_THRESHOLD_LOW=0.25
RISK_THRESHOLD_MEDIUM=0.55
RISK_THRESHOLD_HIGH=0.80

# --- Logging ---
LOG_LEVEL=INFO

# --- Authentication (REQUIRED in production) ---
# Generate a strong random secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_ALGORITHM=HS256
# Token expiry in hours
JWT_EXPIRE_HOURS=8

# Demo credentials (change these for any real deployment)
DEMO_USERNAME=
DEMO_PASSWORD=

# --- Production Mode ---
# Set to "true" in production to disable /docs, restrict CORS, hide error details
PRODUCTION_MODE=false

# --- CORS (production) ---
# Comma-separated list of allowed frontend origins for production
# Example: https://jatayu.example.com,https://www.jatayu.example.com
CORS_ALLOWED_ORIGINS=

# --- Frontend ---
# Base URL for the backend API (used by Vite frontend)
VITE_API_BASE_URL=http://localhost:8000
